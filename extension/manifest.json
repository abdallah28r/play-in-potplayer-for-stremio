{
  "manifest_version": 3,
  "name": "Play in PotPlayer for Stremio",
  "version": "1.3.0",
  "description": "Unofficial. Adds \"Play in PotPlayer\" to the stream right-click menu on Stremio Web.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Play in PotPlayer: settings"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "host_permissions": [
    "http://127.0.0.1:11470/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "permissions": [
    "clipboardWrite",
    "nativeMessaging",
    "storage",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.stremio.com/*"
      ],
      "js": [
        "content.js",
        "notice.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
